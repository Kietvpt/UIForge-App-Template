<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- 1. Local packages directory (Starter template / Offline / Staging) -->
    <add key="LocalPackages" value="../packages" />
    <!-- 2. Official NuGet repository -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    
    <!-- 
    3. GitHub Packages (Private Package Registry):
    To consume UIForge.Core from your GitHub organization:
    <add key="github" value="https://nuget.pkg.github.com/<OWNER>/index.json" />
    -->
  </packageSources>
</configuration>
